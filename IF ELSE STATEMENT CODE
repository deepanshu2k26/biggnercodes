#include <stdio.h>
int main()
{
    int marks = 85;

    if (marks >= 90)
    {
        printf("Grade A+");
    }
    else if (marks >= 80)
    {
        printf("Grade A");
    }
    else if (marks >= 70)
    {
        printf("Grade B");
    }
    else if (marks >= 40)
    {
        printf("Grade C");
    }
    else
    {
        printf("Fail");
    }

    return 0;
}
